# Drizzle
# Replace with your DB credentials! For a local embedded database use: pglite:./.pglite
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email (optional) — https://resend.com. Without these, the admin is shown
# new members' passwords to share by hand.
RESEND_API_KEY=""
EMAIL_FROM="SEF Secretariat <secretariat@your-domain.com>"
